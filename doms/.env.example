########################################################
# SERVER
########################################################
SERVER_PORT=8080


########################################################
# NEON POSTGRESQL DATABASE
########################################################
DB_URL=jdbc:postgresql://localhost:5432/doms
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_MINIMUM_IDLE=0
DB_MAXIMUM_POOL_SIZE=5
DB_IDLE_TIMEOUT=60000
DB_KEEPALIVE_TIME=30000
DB_MAX_LIFETIME=120000
DB_CONNECTION_TIMEOUT=30000
DB_VALIDATION_TIMEOUT=5000

########################################################
# JWT
########################################################
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=86400000


########################################################
# SMTP / EMAIL
########################################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_smtp_from_address


########################################################
# OTP
########################################################
OTP_EXPIRY_MINUTES=10

PUBLIC_CREATE_RATE_LIMIT_PER_MINUTE=20

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=doms/documents
